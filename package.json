{
    "name": "chatbot",
    "private": true,
    "workspaces": [
        "app/frontend",
        "app/server"
    ],
    "scripts": {
        "clean:all": "bun run --filter '*' clean",
        "build:all": "bun run --filter '*' build",
        "start:frontend": "bun run --filter frontend start",
        "start:server": "bun run --filter server start",
        "start": "bun run start:frontend & bun run start:server",
        "format": "prettier --write ."
    },
    "dependencies": {
        "@types/uuid": "^10.0.0",
        "playwright": "^1.50.1",
        "typescript": "^6.0.2",
        "uuid": "^11.0.5"
    },
    "devDependencies": {
        "@babel/generator": "^7.26.5",
        "@types/node": "^22.10.10",
        "axios": "^1.3.0",
        "prettier": "^2.8.8",
        "ts-node": "^10.9.1"
    }
}
